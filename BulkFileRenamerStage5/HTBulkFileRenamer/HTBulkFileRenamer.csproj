<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HTBulkFileRenamer</AssemblyName>

    <!-- HTREASURE LTD product identity (HTREASURE-Branding/brand.json). Shown in the About box and file properties. -->
    <Product>HT Bulk File Renamer</Product>
    <AssemblyTitle>HT Bulk File Renamer</AssemblyTitle>
    <Description>Rename many files at once with previewed, reversible rules.</Description>
    <Version>0.6.0</Version>
    <Company>HTREASURE LTD</Company>
    <Authors>HTREASURE LTD</Authors>
    <!-- Year comes from the build date so the copyright line never goes stale. -->
    <Copyright>Copyright © $([System.DateTime]::Now.Year) HTREASURE LTD. All rights reserved.</Copyright>
    <ApplicationIcon>Branding\HT-bulk-file-renamer.ico</ApplicationIcon>
    <!-- Declares longPathAware so paths of 260+ characters work where Windows long paths are enabled. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Branding\*.ico;Branding\*.png" LogicalName="Branding.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
